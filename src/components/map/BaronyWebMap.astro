---
// The Barony of Thunder Bluff as a web map, used the way you use Google Maps: zoom from the whole barony down to a single
// street, switch between Map, Terrain and Satellite, search for a place and read its card, measure a journey.  The tiles hold only
// what is measured in metres (the land's cover, its relief, the lakes and rivers); the roads, streams, walls, buildings and every
// name are drawn by the page from features.json, so they stay sharp at any zoom and can be switched off.  Both are generated by
// the barony's terrain tools (webmap.py) into public/maps/barony/.  Coordinates are metres east (x) and south (z), as the terrain
// work has them; Leaflet's (lat, lng) is (-z, x).
import '../../styles/barony-webmap.css';

interface WikiInfo {
  title: string;
  description: string;
  url: string;
  sessions: number;
}

interface Props {
  wiki: Record<string, WikiInfo>;
  basePath: string;
}

const { wiki, basePath } = Astro.props;
const tiles = `${basePath}/maps/barony`;
---

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="bw-root" id="bw-root">
  <div id="bw-map" class="bw-map" role="application" aria-label="Map of the Barony of Thunder Bluff"></div>

  <div class="bw-search" role="search">
    <div class="bw-search-box">
      <input id="bw-q" type="text" placeholder="Search the barony" autocomplete="off" spellcheck="false" aria-label="Search the barony"
        role="combobox" aria-autocomplete="list" aria-controls="bw-suggest" aria-expanded="false" />
      <button class="bw-icon-btn" id="bw-q-clear" aria-label="Clear the search" hidden>
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
      </button>
      <button class="bw-icon-btn" id="bw-q-go" aria-label="Search">
        <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
      </button>
    </div>
    <div id="bw-suggest" class="bw-suggest" role="listbox" hidden></div>
  </div>

  <section id="bw-panel" class="bw-panel" hidden aria-label="The chosen place"></section>

  <div class="bw-layers" id="bw-layers">
    <button class="bw-layers-main" id="bw-layers-main" type="button" aria-label="Switch to Satellite"><span>Satellite</span></button>
    <div class="bw-layers-more" role="group" aria-label="Map details">
      <div class="bw-layer-opt-wrap"><button class="bw-layer-opt" type="button" data-opt="terrain" aria-pressed="false" aria-label="Terrain"></button><span>Terrain</span></div>
      <div class="bw-layer-opt-wrap"><button class="bw-layer-opt" type="button" data-opt="contours" aria-pressed="false" aria-label="Contours"></button><span>Contours</span></div>
      <div class="bw-layer-opt-wrap"><button class="bw-layer-opt" type="button" data-opt="streams" aria-pressed="true" aria-label="Streams"></button><span>Streams</span></div>
      <div class="bw-layer-opt-wrap"><button class="bw-layer-opt" type="button" data-opt="labels" aria-pressed="true" aria-label="Labels"></button><span>Labels</span></div>
    </div>
  </div>

  <a class="bw-inset" href="#sword-coast/thunder-bluff" id="bw-inset" aria-label="Where the barony is on the Sword Coast map"
    style={`background-image:url(${tiles}/inset.webp)`}><span>Sword Coast</span></a>

  <div class="bw-measure" id="bw-measure" hidden>
    <div><strong id="bw-measure-d">0 ft</strong><small id="bw-measure-t">Click the map to add points</small></div>
    <button class="bw-icon-btn" id="bw-measure-x" aria-label="Stop measuring">
      <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
    </button>
  </div>

  <div class="bw-menu" id="bw-menu" hidden role="menu"></div>
  <div class="bw-loading" id="bw-loading">Loading the map…</div>
</div>

<script id="bw-data" type="application/json" set:html={JSON.stringify({ wiki, basePath })} />

<script>
  // @ts-nocheck
  const ROOT = document.getElementById('bw-root');
  let started = false;
  let mapRef = null;

  window.addEventListener('reliquary-map-tab', (e) => {
    if (e.detail === 'barony') start();
  });
  if (ROOT && ROOT.offsetParent !== null) start();

  const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
  const fold = (s) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
  const MILE = 1609.344;
  const FT = 3.28084;

  function distText(m) {
    const mi = m / MILE;
    if (mi < 0.2) return `${Math.round((m * FT) / 10) * 10} ft`;
    return `${mi < 10 ? mi.toFixed(1) : Math.round(mi)} mi`;
  }

  function walkText(m) {
    // A normal pace, as the Player's Handbook has it: 3 miles an hour, 24 a day.
    const h = m / MILE / 3;
    if (h < 1) return `about ${Math.max(1, Math.round(h * 60))} min on foot`;
    const hh = Math.floor(h);
    const mm = Math.round((h - hh) * 60);
    return `about ${hh} h${mm ? ` ${mm} min` : ''} on foot`;
  }

  async function start() {
    if (started) {
      if (mapRef) setTimeout(() => mapRef.invalidateSize(), 0);
      return;
    }
    started = true;
    const L = await import('https://unpkg.com/leaflet@1.9.4/dist/leaflet-src.esm.js');
    const { wiki, basePath } = JSON.parse(document.getElementById('bw-data').textContent || '{}');
    const base = `${basePath}/maps/barony`;
    let F;
    try {
      F = await (await fetch(`${base}/features.json`)).json();
    } catch (err) {
      document.getElementById('bw-loading').textContent = 'The map could not be loaded.';
      return;
    }
    document.getElementById('bw-loading').hidden = true;

    // ------------------------------------------------------------------ the frame, in metres
    const [X0, X1, Z0, Z1] = F.frame;
    const CRS = L.extend({}, L.CRS.Simple, { transformation: new L.Transformation(1, -X0, -1, -Z0) });
    const ll = (x, z) => L.latLng(-z, x);
    const xz = (latlng) => [latlng.lng, -latlng.lat];
    const frame = L.latLngBounds(ll(X0, Z1), ll(X1, Z0));

    const map = L.map('bw-map', {
      crs: CRS,
      minZoom: F.zoom.min,
      maxZoom: F.zoom.max,
      zoomSnap: 0.25,
      zoomDelta: 0.5,
      wheelPxPerZoomLevel: 110,
      zoomControl: false,
      maxBounds: frame.pad(0.12),
      maxBoundsViscosity: 0.85,
    });
    mapRef = map;
    map.attributionControl.addAttribution('The barony from its geological and hydrological model');
    L.control.scale({ position: 'bottomright', metric: false, imperial: true, maxWidth: 130 }).addTo(map);
    L.control.zoom({ position: 'bottomright', zoomInTitle: 'Zoom in', zoomOutTitle: 'Zoom out' }).addTo(map);

    // ------------------------------------------------------------------ tiles
    const BLANK = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
    const tileOpts = {
      minZoom: F.zoom.min, maxZoom: F.zoom.max, minNativeZoom: F.zoom.min, maxNativeZoom: F.zoom.maxNative,
      bounds: frame, noWrap: true, keepBuffer: 3, errorTileUrl: BLANK,
    };
    const baseOpts = tileOpts;
    const bases = {
      map: L.tileLayer(`${base}/map/{z}/{x}/{y}.webp`, baseOpts),
      terrain: L.tileLayer(`${base}/terrain/{z}/{x}/{y}.webp`, baseOpts),
      satellite: L.tileLayer(`${base}/satellite/{z}/{x}/{y}.webp`, baseOpts),
    };
    const contours = L.tileLayer(`${base}/contours/{z}/{x}/{y}.webp`, { ...tileOpts, zIndex: 5 });

    // ------------------------------------------------------------------ vectors, each in its own pane and canvas
    const pane = (name, z) => {
      map.createPane(name).style.zIndex = z;
      return L.canvas({ pane: name, padding: 0.5 });
    };
    const rStreams = pane('bw-streams', 405);
    const rBuildings = pane('bw-buildings', 410);
    const rRoads = pane('bw-roads', 420);
    const rWalls = pane('bw-walls', 425);

    const RANK = {
      track: { minZ: -3, w: [1.2, 0.25, 0], color: '#988d7c', dash: '5 4' },
      path: { minZ: -2.5, w: [1.2, 0.25, 0], color: '#988d7c', dash: '1 4' },
      ferry: { minZ: -3, w: [1.6, 0.3, 0], color: '#4f86c0', dash: '6 5' },
      lane: { minZ: -4, w: [1.1, 0.5, 5], fill: '#ffffff', casing: '#c3bbad' },
      road: { minZ: -5, w: [1.3, 0.6, 7], fill: '#ffffff', casing: '#b1a897' },
      trade: { minZ: -9, w: [2.2, 0.7, 10], fill: '#fbd57c', casing: '#dc9b3b' },
    };
    const roadW = (r, z) => {
      const s = RANK[r].w;
      return Math.max(s[0] + Math.max(0, z - Math.max(RANK[r].minZ, -6)) * s[1], s[2] * 2 ** z);
    };
    const roadLines = { track: [], path: [], ferry: [], lane: [], road: [], trade: [] };
    const roadCasings = { lane: [], road: [], trade: [] };
    const named = new Map();
    for (const rd of F.roads) {
      const lls = rd.p.map(([x, z]) => ll(x, z));
      const spec = RANK[rd.r];
      if (spec.casing) {
        roadCasings[rd.r].push(L.polyline(lls, { renderer: rRoads, color: spec.casing, lineCap: 'round', lineJoin: 'round', interactive: false }));
        roadLines[rd.r].push(L.polyline(lls, { renderer: rRoads, color: spec.fill, lineCap: 'round', lineJoin: 'round', interactive: false }));
      } else {
        roadLines[rd.r].push(L.polyline(lls, { renderer: rRoads, color: spec.color, dashArray: spec.dash, lineCap: 'butt', interactive: false }));
      }
      if (rd.n) {
        if (!named.has(rd.n)) named.set(rd.n, { name: rd.n, rank: rd.r, runs: [] });
        named.get(rd.n).runs.push(rd.p);
      }
    }
    // Drawn in order: the dashed ways, then every casing under every fill, so junctions join.
    const roadOrder = [
      ...['track', 'path', 'ferry'].map((r) => [r, roadLines[r]]),
      ...['lane', 'road', 'trade'].map((r) => [r, roadCasings[r]]),
      ...['lane', 'road', 'trade'].map((r) => [r, roadLines[r]]),
    ];
    const roadsGroup = L.layerGroup().addTo(map);

    const streams = F.streams.map((s) => ({ w: s.w, line: L.polyline(s.p.map(([x, z]) => ll(x, z)), { renderer: rStreams, color: '#86bbe2', lineCap: 'round', lineJoin: 'round', interactive: false }) }));
    const streamsGroup = L.layerGroup();

    const walls = F.walls.map((w) => L.polyline(w.p.map(([x, z]) => ll(x, z)), {
      renderer: rWalls, interactive: false,
      color: w.k === 'ruin' ? '#8a7f70' : w.k === 'palisade' ? '#8a7a62' : '#8f8170',
      dashArray: w.k === 'ruin' ? '4 4' : null, kind: w.k,
    }));
    const wallsGroup = L.layerGroup(walls);

    const houseStyle = { renderer: rBuildings, color: '#cfc8bb', weight: 0.6, fillColor: '#e4dfd6', fillOpacity: 1, interactive: false };
    const houses = L.layerGroup(F.buildings.map(([x, z, w, d, a]) => {
      const c = Math.cos(a), s = Math.sin(a);
      return L.polygon([[-w, -d], [w, -d], [w, d], [-w, d]].map(([u, v]) => ll(x + u * c - v * s, z + u * s + v * c)), houseStyle);
    }));
    const farms = L.layerGroup(F.farms.map(([x, z]) => L.circleMarker(ll(x, z), {
      renderer: rBuildings, radius: 2.6, color: '#fff', weight: 1, fillColor: '#a0896b', fillOpacity: 1, interactive: false,
    })));

    // ------------------------------------------------------------------ state
    const state = { base: 'map', contours: false, contoursChosen: null, streams: true, labels: true, selected: null };
    const isSat = () => state.base === 'satellite';

    function styleVectors() {
      const z = map.getZoom();
      const sat = isSat();
      roadsGroup.clearLayers();
      for (const [r, lines] of roadOrder) {
        const spec = RANK[r];
        if (z < spec.minZ) continue;
        const casing = lines === roadCasings[r];
        const w = roadW(r, z);
        for (const ln of lines) {
          ln.setStyle({
            weight: casing ? w + 2 : w,
            opacity: sat ? (casing ? 0.35 : spec.dash ? 0.9 : 0.8) : 1,
            color: sat && spec.dash ? '#f1e7d0' : casing ? spec.casing : spec.fill || spec.color,
          });
          roadsGroup.addLayer(ln);
        }
      }
      streamsGroup.clearLayers();
      if (state.streams) {
        for (const s of streams) {
          if (z < -4.5 && s.w < 4) continue;
          if (z < -5.5) continue;
          s.line.setStyle({ weight: Math.max(z < -3 ? 0.8 : 1.1, s.w * 2 ** z), color: sat ? '#a9d6f7' : '#86bbe2', opacity: sat ? 0.75 : 1 });
          streamsGroup.addLayer(s.line);
        }
        if (!map.hasLayer(streamsGroup)) streamsGroup.addTo(map);
      } else if (map.hasLayer(streamsGroup)) map.removeLayer(streamsGroup);
      const wallsOn = z >= -4.5;
      for (const w of walls) w.setStyle({ weight: w.options.kind === 'wall' ? Math.max(1.4, Math.min(4, 2.5 * 2 ** (z + 2))) : 1.3, opacity: sat ? 0.7 : 1 });
      if (wallsOn && !map.hasLayer(wallsGroup)) wallsGroup.addTo(map);
      if (!wallsOn && map.hasLayer(wallsGroup)) map.removeLayer(wallsGroup);
      const housesOn = z >= -2.25 && !sat;
      if (housesOn && !map.hasLayer(houses)) houses.addTo(map);
      if (!housesOn && map.hasLayer(houses)) map.removeLayer(houses);
      const farmsOn = z >= -3 && !sat;
      if (farmsOn && !map.hasLayer(farms)) farms.addTo(map);
      if (!farmsOn && map.hasLayer(farms)) map.removeLayer(farms);
    }

    // ------------------------------------------------------------------ lettering
    const KIND = { city: 'City', town: 'Village', place: 'Landmark', minor: 'Point of interest', region: 'Region', water: 'Water' };
    const PRI = { city: 100, town: 80, water: 55, place: 60, region: 45, minor: 30 };
    const places = F.places;
    const byId = new Map(places.map((p) => [p.id, p]));
    const labelMarkers = places.map((p) => {
      const area = p.k === 'region' || p.k === 'water';
      const html = area
        ? `<span class="bw-t">${esc(p.name)}</span>`
        : `<span class="bw-dot"></span><span class="bw-t" style="left:${p.k === 'city' ? 12 : p.k === 'minor' ? 8 : 10}px;top:${p.k === 'city' ? -11 : p.k === 'town' ? -9 : -8}px">${esc(p.name)}</span>`;
      const m = L.marker(ll(p.x, p.z), {
        icon: L.divIcon({ className: `bw-label bw-k-${p.k}`, html, iconSize: [0, 0] }),
        keyboard: false, title: '', riseOnHover: true,
      });
      m.on('click', () => select(p, { fly: false }));
      m.place = p;
      return m;
    });
    const labelsGroup = L.layerGroup().addTo(map);
    let roadLabels = [];

    function roadNameMarkers(z) {
      const out = [];
      for (const r of named.values()) {
        const need = r.rank === 'trade' ? -4.5 : r.rank === 'road' ? -3.25 : -2.5;
        if (z < need) continue;
        const s = 2 ** z;
        const spacing = 520;
        for (const run of r.runs) {
          const seg = [0];
          for (let i = 1; i < run.length; i++) seg.push(seg[i - 1] + Math.hypot(run[i][0] - run[i - 1][0], run[i][1] - run[i - 1][1]));
          const len = seg[seg.length - 1] * s;
          if (len < 160) continue;
          const n = Math.max(1, Math.floor(len / spacing));
          for (let k = 0; k < n; k++) {
            const at = ((k + 0.5) * len) / n / s;
            const pt = (t) => {
              const tt = Math.max(0, Math.min(seg[seg.length - 1], t));
              let i = 1;
              while (i < seg.length - 1 && seg[i] < tt) i++;
              const f = (tt - seg[i - 1]) / Math.max(1e-9, seg[i] - seg[i - 1]);
              return [run[i - 1][0] + f * (run[i][0] - run[i - 1][0]), run[i - 1][1] + f * (run[i][1] - run[i - 1][1])];
            };
            const [x, zz] = pt(at);
            const a = pt(at - 40 / s), b = pt(at + 40 / s);
            let ang = (Math.atan2(b[1] - a[1], b[0] - a[0]) * 180) / Math.PI;
            if (ang > 90) ang -= 180;
            if (ang < -90) ang += 180;
            out.push(L.marker(ll(x, zz), {
              icon: L.divIcon({ className: 'bw-label bw-k-road', html: `<span class="bw-t" style="transform:translate(-50%,-50%) rotate(${ang.toFixed(1)}deg)">${esc(r.name)}</span>`, iconSize: [0, 0] }),
              keyboard: false, interactive: false, pri: 20,
            }));
          }
        }
      }
      return out;
    }

    function rectOf(el) {
      let r = null;
      for (const c of el.children) {
        const b = c.getBoundingClientRect();
        if (!b.width && !b.height) continue;
        r = r ? { l: Math.min(r.l, b.left), t: Math.min(r.t, b.top), r: Math.max(r.r, b.right), b: Math.max(r.b, b.bottom) } : { l: b.left, t: b.top, r: b.right, b: b.bottom };
      }
      return r;
    }

    function declutter() {
      const items = [];
      labelsGroup.eachLayer((m) => {
        const el = m.getElement();
        if (!el) return;
        el.classList.remove('bw-hidden');
        const p = m.place;
        const pri = p ? (state.selected && state.selected.id === p.id ? 1000 : PRI[p.k] + (p.z0 <= -6 ? 10 : 0)) : m.options.pri || 0;
        items.push({ el, pri });
      });
      items.sort((a, b) => b.pri - a.pri);
      const placed = [];
      for (const it of items) {
        const r = rectOf(it.el);
        if (!r) continue;
        const hit = placed.some((q) => r.l < q.r + 3 && r.r > q.l - 3 && r.t < q.b + 2 && r.b > q.t - 2);
        if (hit) it.el.classList.add('bw-hidden');
        else placed.push(r);
      }
    }

    function letter() {
      const z = map.getZoom();
      labelsGroup.clearLayers();
      if (state.labels) {
        for (const m of labelMarkers) {
          const p = m.place;
          const show = z >= p.z0 && !(p.k === 'region' && z > -3) && !(p.k === 'water' && p.z0 <= -5 && p.id.startsWith('rauvin') && z > -2.5);
          if (show || (state.selected && state.selected.id === p.id)) labelsGroup.addLayer(m);
        }
        roadLabels = roadNameMarkers(z);
        for (const m of roadLabels) labelsGroup.addLayer(m);
      }
      requestAnimationFrame(declutter);
    }

    // ------------------------------------------------------------------ the chosen place: a red pin and its card
    const pinIcon = L.divIcon({
      className: 'bw-pin', iconSize: [27, 43], iconAnchor: [13.5, 42],
      html: '<svg width="27" height="43" viewBox="0 0 27 43"><path d="M13.5 0C6 0 0 6 0 13.5 0 23.6 13.5 43 13.5 43S27 23.6 27 13.5C27 6 21 0 13.5 0z" fill="#ea4335"/><path d="M13.5 1.5c-6.6 0-12 5.4-12 12 0 8.6 10.6 24.5 12 26.6 1.4-2.1 12-18 12-26.6 0-6.6-5.4-12-12-12z" fill="none" stroke="#b31412" stroke-width="1"/><circle cx="13.5" cy="13.5" r="4.6" fill="#7a0c0b"/></svg>',
    });
    let pin = null;
    const panel = document.getElementById('bw-panel');

    function select(p, { fly = true } = {}) {
      state.selected = p;
      if (pin) map.removeLayer(pin);
      const area = p.k === 'region' || p.k === 'water';
      pin = area ? null : L.marker(ll(p.x, p.z), { icon: pinIcon, interactive: false, keyboard: false, zIndexOffset: 1000 }).addTo(map);
      if (fly) {
        const target = Math.max(map.getZoom(), area ? Math.min(-4, p.z0 + 1) : Math.max(p.z0 + 1, -3));
        map.flyTo(ll(p.x, p.z), Math.min(target, F.zoom.max), { duration: 0.8 });
      }
      // An entry about the place gives its description; an entry the place is only part of (p.in: Hammerfall in the Thunder Rapids')
      // is offered to read, and the place keeps its own note.
      const info = p.slug ? wiki[p.slug] : p.in ? wiki[p.in] : null;
      const about = !!p.slug;
      const desc = (about && info && info.description) || p.note || '';
      const nd = byId.get('new-daggerford');
      const fromCity = nd && p.id !== 'new-daggerford' && !area ? Math.hypot(p.x - nd.x, p.z - nd.z) : null;
      const facts = [];
      if (p.ft !== undefined) facts.push(`<li>${icon('elev')}${p.ft === 0 ? 'At the level of Lake Selûna' : `${Math.abs(p.ft).toLocaleString()} ft ${p.ft > 0 ? 'above' : 'below'} Lake Selûna`}</li>`);
      if (fromCity) facts.push(`<li>${icon('dist')}${distText(fromCity)} from New Daggerford as the crow flies, ${walkText(fromCity)}</li>`);
      if (about && info && info.sessions) facts.push(`<li>${icon('book')}In ${info.sessions} diary ${info.sessions === 1 ? 'session' : 'sessions'}</li>`);
      const img = p.img ? `<img class="bw-panel-img" src="${basePath}/images/barony/${p.img}" alt="" loading="lazy" />` : '';
      panel.innerHTML = `
        <button class="bw-icon-btn bw-panel-close" type="button" aria-label="Close">${icon('close')}</button>
        ${img}
        <div class="bw-panel-body">
          <h2>${esc(p.name)}</h2>
          <div class="bw-panel-kind">${KIND[p.k]}${info && info.title !== p.name ? ` · ${esc(info.title)}` : ''}</div>
          ${desc ? `<p class="bw-panel-desc">${esc(desc)}</p>` : ''}
          <div class="bw-panel-actions">
            ${info ? `<a class="bw-chip bw-primary" href="${info.url}">${icon('book', '#fff')}${about ? 'Wiki entry' : `Read about ${esc(info.title)}`}</a>` : ''}
            <button class="bw-chip" type="button" data-act="measure">${icon('ruler')}Measure from here</button>
            <button class="bw-chip" type="button" data-act="share">${icon('link')}<span>Copy link</span></button>
          </div>
          ${facts.length ? `<ul class="bw-panel-facts">${facts.join('')}</ul>` : ''}
        </div>`;
      panel.hidden = false;
      panel.querySelector('.bw-panel-close').addEventListener('click', deselect);
      panel.querySelector('[data-act="measure"]').addEventListener('click', () => startMeasure(ll(p.x, p.z)));
      panel.querySelector('[data-act="share"]').addEventListener('click', (e) => {
        writeHash();
        navigator.clipboard?.writeText(location.href).then(() => {
          e.currentTarget.querySelector('span').textContent = 'Link copied';
        });
      });
      letter();
      writeHash();
    }

    function deselect() {
      state.selected = null;
      if (pin) map.removeLayer(pin);
      pin = null;
      panel.hidden = true;
      letter();
      writeHash();
    }

    function icon(name, color = 'currentColor') {
      const d = {
        close: 'M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z',
        book: 'M18 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 4h5v8l-2.5-1.5L6 12V4z',
        ruler: 'M21 6H3c-1.1 0-2 .9-2 2v8c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 10H3V8h2v4h2V8h2v4h2V8h2v4h2V8h2v4h2V8h2v8z',
        link: 'M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z',
        elev: 'M14 6l-3.75 5 2.85 3.8-1.6 1.2C9.81 13.75 7 10 7 10l-6 8h22L14 6z',
        dist: 'M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 0 1 0-5 2.5 2.5 0 0 1 0 5z',
      }[name];
      return `<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="${color}" d="${d}"/></svg>`;
    }

    // ------------------------------------------------------------------ search
    const q = document.getElementById('bw-q');
    const sugg = document.getElementById('bw-suggest');
    const qClear = document.getElementById('bw-q-clear');
    const seen = new Set();
    const index = [];
    for (const p of places) {
      if (seen.has(p.name)) continue;
      seen.add(p.name);
      index.push({ name: p.name, sub: KIND[p.k], key: fold(p.name), place: p });
    }
    for (const r of named.values()) {
      if (seen.has(r.name)) continue;
      seen.add(r.name);
      index.push({ name: r.name, sub: 'Road', key: fold(r.name), road: r });
    }
    let hits = [];
    let cursor = -1;

    function suggest() {
      const v = fold(q.value.trim());
      qClear.hidden = !q.value;
      if (!v) {
        sugg.hidden = true;
        q.setAttribute('aria-expanded', 'false');
        return;
      }
      const starts = index.filter((it) => it.key.split(/[\s'’-]+/).some((w) => w.startsWith(v)) || it.key.startsWith(v));
      const rest = index.filter((it) => !starts.includes(it) && it.key.includes(v));
      hits = [...starts, ...rest].slice(0, 8);
      cursor = hits.length ? 0 : -1;
      sugg.innerHTML = hits.length
        ? hits.map((h, i) => `<button type="button" role="option" id="bw-s-${i}" aria-selected="${i === cursor}"><span class="bw-s-dot">${icon(h.road ? 'dist' : h.place.k === 'region' || h.place.k === 'water' ? 'elev' : 'dist')}</span>${esc(h.name)}<span class="bw-s-kind">${h.sub}</span></button>`).join('')
        : '<div style="padding:12px 16px;font-size:14px;color:#5f6368">Nothing by that name in the barony.</div>';
      sugg.hidden = false;
      q.setAttribute('aria-expanded', 'true');
      sugg.querySelectorAll('button').forEach((b, i) => b.addEventListener('click', () => choose(hits[i])));
    }

    function choose(h) {
      if (!h) return;
      q.value = h.name;
      sugg.hidden = true;
      q.setAttribute('aria-expanded', 'false');
      if (h.place) select(h.place);
      else {
        const b = L.latLngBounds(h.road.runs.flat().map(([x, z]) => ll(x, z)));
        map.flyToBounds(b, { padding: [60, 60], maxZoom: -2, duration: 0.8 });
      }
      q.blur();
    }

    q.addEventListener('input', suggest);
    q.addEventListener('focus', () => q.value && suggest());
    q.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        if (!hits.length) return;
        e.preventDefault();
        cursor = (cursor + (e.key === 'ArrowDown' ? 1 : hits.length - 1)) % hits.length;
        sugg.querySelectorAll('button').forEach((b, i) => b.setAttribute('aria-selected', String(i === cursor)));
        q.setAttribute('aria-activedescendant', `bw-s-${cursor}`);
      } else if (e.key === 'Enter') {
        e.preventDefault();
        choose(hits[Math.max(cursor, 0)]);
      } else if (e.key === 'Escape') {
        sugg.hidden = true;
        q.setAttribute('aria-expanded', 'false');
      }
    });
    document.getElementById('bw-q-go').addEventListener('click', () => {
      suggest();
      choose(hits[0]);
    });
    qClear.addEventListener('click', () => {
      q.value = '';
      suggest();
      q.focus();
    });
    document.addEventListener('click', (e) => {
      if (!e.target.closest('.bw-search')) sugg.hidden = true;
    });

    // ------------------------------------------------------------------ layers
    const layersBox = document.getElementById('bw-layers');
    const mainBtn = document.getElementById('bw-layers-main');
    const thumb = (layer) => `url(${base}/${layer}/-4/1/1.webp)`;
    const opts = [...layersBox.querySelectorAll('.bw-layer-opt')];
    opts.forEach((b) => {
      b.style.backgroundImage = thumb(b.dataset.opt === 'terrain' || b.dataset.opt === 'contours' ? 'terrain' : 'map');
    });

    function setBase(name) {
      for (const [k, l] of Object.entries(bases)) if (k !== name && map.hasLayer(l)) map.removeLayer(l);
      if (!map.hasLayer(bases[name])) bases[name].addTo(map);
      bases[name].bringToBack();
      state.base = name;
      // Terrain brings its contours, as Google's does, unless they were switched off by hand.
      const want = state.contoursChosen !== null ? state.contoursChosen : name === 'terrain';
      setContours(want, false);
      ROOT.classList.toggle('bw-sat', name === 'satellite');
      const other = name === 'satellite' ? 'map' : 'satellite';
      mainBtn.style.backgroundImage = thumb(other);
      mainBtn.querySelector('span').textContent = other === 'map' ? 'Map' : 'Satellite';
      mainBtn.setAttribute('aria-label', `Switch to ${other === 'map' ? 'Map' : 'Satellite'}`);
      syncOpts();
      styleVectors();
      writeHash();
    }

    function setContours(on, chosen = true) {
      if (chosen) state.contoursChosen = on;
      state.contours = on;
      if (on && !map.hasLayer(contours)) contours.addTo(map);
      if (!on && map.hasLayer(contours)) map.removeLayer(contours);
      syncOpts();
    }

    function syncOpts() {
      for (const b of opts) {
        const o = b.dataset.opt;
        const on = o === 'terrain' ? state.base === 'terrain' : state[o];
        b.setAttribute('aria-pressed', String(!!on));
      }
    }

    mainBtn.addEventListener('click', () => setBase(state.base === 'satellite' ? 'map' : 'satellite'));
    for (const b of opts) {
      b.addEventListener('click', () => {
        const o = b.dataset.opt;
        if (o === 'terrain') setBase(state.base === 'terrain' ? 'map' : 'terrain');
        else if (o === 'contours') setContours(!state.contours);
        else {
          state[o] = !state[o];
          syncOpts();
          if (o === 'streams') styleVectors();
          if (o === 'labels') letter();
        }
      });
    }

    // ------------------------------------------------------------------ measuring, and the right-click menu
    const menu = document.getElementById('bw-menu');
    const meas = document.getElementById('bw-measure');
    let measure = null;

    function startMeasure(from) {
      stopMeasure();
      measure = {
        pts: [],
        line: L.polyline([], { color: '#1a73e8', weight: 3, dashArray: '1 6', lineCap: 'round', interactive: false }).addTo(map),
        dots: L.layerGroup().addTo(map),
      };
      meas.hidden = false;
      if (from) addMeasure(from);
      updateMeasure();
      map.getContainer().style.cursor = 'crosshair';
    }

    function addMeasure(latlng) {
      measure.pts.push(latlng);
      measure.line.setLatLngs(measure.pts);
      L.circleMarker(latlng, { radius: 5, color: '#1a73e8', weight: 2, fillColor: '#fff', fillOpacity: 1, interactive: false }).addTo(measure.dots);
      updateMeasure();
    }

    function updateMeasure() {
      let m = 0;
      for (let i = 1; i < measure.pts.length; i++) m += map.distance(measure.pts[i - 1], measure.pts[i]);
      document.getElementById('bw-measure-d').textContent = distText(m);
      document.getElementById('bw-measure-t').textContent = measure.pts.length < 2 ? 'Click the map to add points' : `${walkText(m)}, at a normal pace (3 mph)`;
    }

    function stopMeasure() {
      if (!measure) return;
      map.removeLayer(measure.line);
      map.removeLayer(measure.dots);
      measure = null;
      meas.hidden = true;
      map.getContainer().style.cursor = '';
    }

    document.getElementById('bw-measure-x').addEventListener('click', stopMeasure);

    map.on('click', (e) => {
      menu.hidden = true;
      if (measure) {
        addMeasure(e.latlng);
        return;
      }
      if (state.selected && !e.originalEvent.target.closest('.bw-label')) deselect();
    });

    map.on('contextmenu', (e) => {
      const [x, z] = xz(e.latlng);
      const pt = e.containerPoint;
      menu.innerHTML = `
        <div>${Math.round(x)} m east, ${Math.round(-z)} m north</div>
        <button type="button" role="menuitem" data-m="measure">Measure distance</button>
        <button type="button" role="menuitem" data-m="centre">Centre the map here</button>
        <button type="button" role="menuitem" data-m="link">Copy a link to here</button>`;
      const W = ROOT.clientWidth, H = ROOT.clientHeight;
      menu.style.left = `${Math.min(pt.x, W - 220)}px`;
      menu.style.top = `${Math.min(pt.y, H - 160)}px`;
      menu.hidden = false;
      menu.querySelector('[data-m="measure"]').onclick = () => { menu.hidden = true; startMeasure(e.latlng); };
      menu.querySelector('[data-m="centre"]').onclick = () => { menu.hidden = true; map.panTo(e.latlng); };
      menu.querySelector('[data-m="link"]').onclick = () => {
        menu.hidden = true;
        map.panTo(e.latlng, { animate: false });
        writeHash();
        navigator.clipboard?.writeText(location.href);
      };
    });
    map.on('movestart', () => (menu.hidden = true));
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || ROOT.offsetParent === null) return;
      if (measure) stopMeasure();
      else if (!menu.hidden) menu.hidden = true;
      else if (state.selected && document.activeElement !== q) deselect();
    });

    // ------------------------------------------------------------------ the link keeps the view: #barony/zoom/x/north/layer[/place]
    let writing = false;
    function writeHash() {
      // The barony's tab is the default, so a bare /map/ is it too: write the view whenever it's the one shown.
      if (ROOT.offsetParent === null || location.hash.startsWith('#sword-coast')) return;
      const c = map.getCenter();
      const [x, z] = xz(c);
      const h = `#barony/${map.getZoom()}/${Math.round(x)}/${Math.round(-z)}/${state.base}${state.selected ? `/${state.selected.id}` : ''}`;
      if (h !== location.hash) {
        writing = true;
        history.replaceState(null, '', h);
        writing = false;
      }
    }

    function readHash() {
      const parts = location.hash.replace(/^#/, '').split('/');
      if (parts[0] !== 'barony') return null;
      if (parts[1] === 'place') return { place: parts[2] };
      const zoom = parseFloat(parts[1]), x = parseFloat(parts[2]), north = parseFloat(parts[3]);
      return { zoom, x, z: -north, layer: parts[4], place: parts[5] };
    }

    window.addEventListener('hashchange', () => {
      if (writing) return;
      const h = readHash();
      if (h && h.place && byId.has(h.place)) select(byId.get(h.place));
    });

    // ------------------------------------------------------------------ go
    const fitZoom = map.getBoundsZoom(frame);
    map.setMinZoom(Math.max(F.zoom.min, Math.floor(fitZoom * 4) / 4 - 0.25));
    const h = readHash();
    if (h && Number.isFinite(h.zoom) && Number.isFinite(h.x) && Number.isFinite(h.z)) map.setView(ll(h.x, h.z), h.zoom);
    else map.setView(ll(-10300, -7600), Math.min(-3.5, Math.max(fitZoom + 0.75, -5)));
    setBase(h && bases[h.layer] ? h.layer : 'map');
    map.on('zoomend', () => {
      styleVectors();
      letter();
    });
    map.on('moveend', writeHash);
    styleVectors();
    letter();
    if (h && h.place && byId.has(h.place)) select(byId.get(h.place), { fly: !Number.isFinite(h.zoom) });
  }
</script>
