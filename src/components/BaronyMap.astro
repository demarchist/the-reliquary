---
// A topographic map with its places as real links: the image holds the terrain and the lettering that belongs to the land, and the
// pins are drawn over it, so a name can be clicked and read by a screen reader.  Generated by the barony's terrain tools.
interface Pin {
  n: number;
  label: string;
  slug: string;
  x: number;
  y: number;
  dx: number;
  dy: number;
  anchor: string;
}

interface Props {
  image: string;
  width: number;
  height: number;
  title: string;
  pins: Pin[];
  caption?: string;
  labelSize?: number;
}

const { image, width, height, title, pins, caption, labelSize = 31 } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const src = `${base}${image}`;
---

<figure class="gz-map">
  <div class="gz-map-frame">
    <img src={src} alt={`Topographic map: ${title}.`} width={width} height={height} loading="lazy" />
    <svg viewBox={`0 0 ${width} ${height}`} aria-label={`Places on the map of ${title}`} role="group">
      {pins.map(pin => (
        <a href={`${base}/wiki/${pin.slug}/`} aria-label={pin.label} class="gz-pin">
          <text class="gz-pin-label" x={pin.x + pin.dx * 1.6} y={pin.y + pin.dy * 1.6} text-anchor={pin.anchor} font-size={labelSize}>{pin.label}</text>
          <circle cx={pin.x} cy={pin.y} r="19" />
          <text class="gz-pin-n" x={pin.x} y={pin.y} text-anchor="middle" dominant-baseline="central">{pin.n}</text>
        </a>
      ))}
    </svg>
  </div>
  <figcaption>
    <span class="gz-map-title">{title}</span>
    {caption && <span> {caption}</span>}
    <a href={src} class="gz-map-open">Open the full map</a>
    <a href={`${base}/map/#barony`} class="gz-map-open">Explore on the interactive map</a>
  </figcaption>
  <ol class="gz-map-key">
    {pins.map(pin => (
      <li value={pin.n}><a href={`${base}/wiki/${pin.slug}/`}>{pin.label}</a></li>
    ))}
  </ol>
</figure>
