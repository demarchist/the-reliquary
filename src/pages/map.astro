---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import InteractiveMap from '../components/map/InteractiveMap.astro';
import BaronyWebMap from '../components/map/BaronyWebMap.astro';
import { getCollection } from 'astro:content';
import mapData from '../data/map-locations.json';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');

// Fetch wiki Places and all diary entries at build time
const allWiki = await getCollection('wiki');
const allDiary = await getCollection('diary');

const places = allWiki.filter(e => e.data.category === 'Places');

// Count diary sessions per place slug
const sessionCounts: Record<string, number> = {};
for (const diary of allDiary) {
  const placeSlugs = diary.data.places ?? [];
  for (const slug of placeSlugs) {
    sessionCounts[slug] = (sessionCounts[slug] || 0) + 1;
  }
}

// Merge wiki data with map coordinates
const locations = places
  .filter(place => mapData.locations[place.id as keyof typeof mapData.locations])
  .map(place => ({
    slug: place.id,
    title: place.data.title,
    description: place.data.description || '',
    coordinates: mapData.locations[place.id as keyof typeof mapData.locations],
    sessionCount: sessionCounts[place.id] || 0,
    wikiUrl: `${basePath}/wiki/${place.id}/`,
  }));

// The barony's web map draws its places from public/maps/barony/features.json (generated by the barony's terrain tools); its cards
// take each place's title and description from the wiki entry it names, so they say what the wiki says.
const features = JSON.parse(fs.readFileSync(path.join(process.cwd(), 'public/maps/barony/features.json'), 'utf-8'));
const baronySlugs = new Set<string>(features.places.flatMap((p: { slug?: string; in?: string }) => [p.slug, p.in]).filter(Boolean));
const baronyWiki: Record<string, { title: string; description: string; url: string; sessions: number }> = {};
for (const entry of allWiki) {
  if (baronySlugs.has(entry.id)) {
    baronyWiki[entry.id] = {
      title: entry.data.title,
      description: entry.data.description || '',
      url: `${basePath}/wiki/${entry.id}/`,
      sessions: sessionCounts[entry.id] || 0,
    };
  }
}
---

<BaseLayout title="World Map" fullWidth>
  <div class="relative">
    <div class="map-tabs" role="tablist" aria-label="Maps">
      <button class="map-tab" role="tab" type="button" data-tab="barony" aria-selected="true" aria-controls="map-panel-barony">Thunder Bluff</button>
      <button class="map-tab" role="tab" type="button" data-tab="sword-coast" aria-selected="false" aria-controls="map-panel-sword-coast">Sword Coast</button>
    </div>
    <div id="map-panel-barony" class="map-tab-panel" role="tabpanel" data-panel="barony">
      <BaronyWebMap wiki={baronyWiki} basePath={basePath} />
    </div>
    <div id="map-panel-sword-coast" class="map-tab-panel" role="tabpanel" data-panel="sword-coast" hidden>
      <InteractiveMap locations={locations} maps={mapData.maps} basePath={basePath} />
    </div>
  </div>
</BaseLayout>

<script>
  // Two maps, one page: the barony, the default, and the Sword Coast on its own tab.  The tab follows the link (#sword-coast, or
  // #barony/... for a view of the barony), so either can be shared and the browser's back button moves between them.
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.map-tab')];
  const panels = [...document.querySelectorAll<HTMLElement>('.map-tab-panel')];

  function current() {
    return location.hash.startsWith('#sword-coast') ? 'sword-coast' : 'barony';
  }

  function show(name: string) {
    for (const p of panels) p.hidden = p.dataset.panel !== name;
    for (const t of tabs) t.setAttribute('aria-selected', String(t.dataset.tab === name));
    window.dispatchEvent(new CustomEvent('reliquary-map-tab', { detail: name }));
  }

  for (const t of tabs) {
    t.addEventListener('click', () => {
      if (t.dataset.tab === 'sword-coast') {
        if (!location.hash.startsWith('#sword-coast')) location.hash = '#sword-coast';
      } else if (!location.hash.startsWith('#barony')) {
        location.hash = '#barony';
      }
    });
  }

  window.addEventListener('hashchange', () => {
    show(current());
    if (location.hash === '#sword-coast/thunder-bluff') {
      // From the barony's inset: the Sword Coast map, at Thunder Bluff.
      window.dispatchEvent(new CustomEvent('reliquary-map-focus', { detail: 'thunder-bluff' }));
    }
  });
  window.addEventListener('popstate', () => show(current()));
  show(current());
</script>

<style>
  .map-tabs {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 1001;
    display: flex;
    background: #fff;
    border-radius: 24px;
    padding: 4px;
    box-shadow: 0 1px 2px rgba(60, 64, 67, 0.3), 0 2px 6px 2px rgba(60, 64, 67, 0.15);
    font-family: var(--font-sans);
  }

  .map-tab {
    border: 0;
    background: transparent;
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 14px;
    font-weight: 500;
    color: #5f6368;
    cursor: pointer;
  }

  .map-tab:hover {
    background: #f1f3f4;
    color: #202124;
  }

  .map-tab[aria-selected='true'] {
    background: var(--color-accent-600);
    color: #fff;
  }

  .map-tab:focus-visible {
    outline: 2px solid #1a73e8;
    outline-offset: 2px;
  }

  @media (max-width: 640px) {
    .map-tabs {
      top: 70px;
    }
  }
</style>
